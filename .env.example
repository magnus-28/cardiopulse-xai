# Hybrid Edge + Cloud Configuration
HOST=0.0.0.0
PORT=8000

# Optional: Custom Hospital HL7 FHIR R4 Endpoint (defaults to public HAPI FHIR R4 sandbox)
FHIR_BASE_URL=https://hapi.fhir.org/baseR4

# Optional: Enable Gemini Vision API for handwritten/complex lab report photos when Online Mode is ON
GEMINI_API_KEY=

# Optional: Increase openFDA rate limit (free key at https://open.fda.gov/apis/authentication/)
OPENFDA_API_KEY=
